using Kscan.Core.Imaging;

namespace Kscan.Platform.Abstractions;

/// <summary>
/// 屏幕采集。平台差异很大，因此这里只声明"能力"，具体由各平台实现：
/// <list type="bullet">
///   <item>Windows：自带 <c>BitBlt</c> 抓整个虚拟桌面；框选交给 UI 自己画。</item>
///   <item>Linux/Wayland：不能直接读帧缓冲，改为委托外部命令（默认 <c>grim</c> + <c>slurp</c>）。</item>
/// </list>
/// </summary>
public interface IScreenCapture
{
    bool IsSupported { get; }
    string? LastError => null;

    /// <summary>人类可读的当前实现说明（设置页里展示，例如"grim + slurp"或"BitBlt"）。</summary>
    string Description { get; }

    /// <summary>
    /// 界面文案的 i18n key（如 <c>Platform.Capture.WindowsBitBlt</c>）：表现层会加自己的资源前缀后翻译。
    /// 为 <c>null</c> 时界面直接用 <see cref="Description"/>（未本地化的实现路径）。
    /// </summary>
    string? DescriptionKey => null;

    /// <summary><see cref="DescriptionKey"/> 里 <c>{0}</c> 这类占位符的参数。</summary>
    object?[] DescriptionArguments => [];

    /// <summary>
    /// 抓取整个虚拟桌面（多显示器拼在一起）。
    /// 不支持或失败时返回 <c>null</c>（调用方应给出可读错误，而不是抛异常）。
    /// </summary>
    Task<ImageFrame?> CaptureDesktopAsync(CancellationToken cancellationToken = default);

    /// <summary>
    /// 让平台/外部工具完成"框选"并直接返回选区图像。
    /// 返回 <c>null</c> 表示当前平台没有现成的框选通道（例如 Windows 上由 UI 自绘选区）。
    /// </summary>
    Task<ImageFrame?> CaptureRegionAsync(CancellationToken cancellationToken = default);
}
