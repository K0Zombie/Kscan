    <!-- Global hotkey (M4) -->
    <x:String x:Key="Str.Settings.Hotkey">Global hotkeys</x:String>
    <x:String x:Key="Str.Settings.HotkeyLabel">Hotkey:</x:String>
    <x:String x:Key="Str.Settings.HotkeyPlaceholder">e.g. F1 / Ctrl+Alt+S</x:String>
    <x:String x:Key="Str.Settings.HotkeyRisky">⚠ without a modifier this key is taken from every app</x:String>
