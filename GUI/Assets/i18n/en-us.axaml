    <x:String x:Key="Str.Settings.HotkeyCapture">Record</x:String>
    <x:String x:Key="Str.Settings.HotkeyCaptureTip">Press the combo and it fills in automatically (you still confirm it, so a slip of the finger cannot bind a key)</x:String>
