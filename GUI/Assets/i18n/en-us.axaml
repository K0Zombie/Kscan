    <x:String x:Key="Str.Scroll.Unsupported">Scrolling capture currently supports Windows only.</x:String>
    <x:String x:Key="Str.Scroll.SelectHint">Select scrollable content, avoid fixed headers/footers, and leave space for the capture toolbar.</x:String>
    <x:String x:Key="Str.Scroll.Failed">Scrolling capture failed: {0}</x:String>
