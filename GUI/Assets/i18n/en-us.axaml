<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App / tabs -->
    <x:String x:Key="Str.App.Title">Kscan — Scan / Generate</x:String>
    <x:String x:Key="Str.Tab.Scan">Scan</x:String>
    <x:String x:Key="Str.Tab.Generate">Generate</x:String>
    <x:String x:Key="Str.Tab.Settings">Settings</x:String>

    <!-- Scan page -->
    <x:String x:Key="Str.Scan.OpenFile">From file…</x:String>
    <x:String x:Key="Str.Scan.FromClipboard">From clipboard</x:String>
    <x:String x:Key="Str.Scan.CaptureRegion">Capture region</x:String>
    <x:String x:Key="Str.Scan.NoSource">No image loaded</x:String>
    <x:String x:Key="Str.Scan.Hint">Drop an image here, pick a file, paste from the clipboard, or capture a screen region.</x:String>
    <x:String x:Key="Str.Scan.Copy">Copy</x:String>
    <x:String x:Key="Str.Scan.FormatLabel">Format: {0}</x:String>
    <x:String x:Key="Str.Scan.ClipboardEmpty">No image in the clipboard.</x:String>
    <x:String x:Key="Str.Scan.ClipboardNoText">No text in the clipboard — copy some text first.</x:String>
    <x:String x:Key="Str.Scan.CodedToClipboard">Clipboard text turned into {0} and put back on the clipboard.</x:String>
    <x:String x:Key="Str.Scan.CopiedImageToClipboard">Screenshot copied to the clipboard.</x:String>
    <x:String x:Key="Str.Scan.Capturing">Capturing…</x:String>
    <x:String x:Key="Str.Scan.CaptureUnsupported">Screen capture is not supported on this platform: {0}</x:String>
    <x:String x:Key="Str.Scan.CaptureCancelled">Capture cancelled or failed.</x:String>
    <x:String x:Key="Str.Scan.CaptureFailed">Screen capture failed.</x:String>
    <x:String x:Key="Str.Scan.RegionCancelled">Region selection cancelled.</x:String>
    <x:String x:Key="Str.Scan.CaptureError">Capture error: {0}</x:String>
    <x:String x:Key="Str.Scan.SourceRegion">Region capture</x:String>
    <x:String x:Key="Str.Scan.SourceAnnotation">Annotated capture</x:String>
    <x:String x:Key="Str.Scan.SourceClipboard">Clipboard image</x:String>
    <x:String x:Key="Str.Scan.ReadFailed">Failed to read the image: {0}</x:String>
    <x:String x:Key="Str.Scan.ClipboardReadFailed">Failed to read the clipboard image: {0}</x:String>
    <x:String x:Key="Str.Scan.ScanFailed">Scan failed: {0}</x:String>
    <x:String x:Key="Str.Scan.FoundWithHint">Found {0} code(s) in {1} ms.{2}</x:String>
    <x:String x:Key="Str.Scan.AutoCopied"> Copied to the clipboard.</x:String>
    <x:String x:Key="Str.Scan.AutoCopyDisabled"> Enable “auto copy” or “open links” on the Settings tab.</x:String>
    <x:String x:Key="Str.Scan.UrlOpened"> Opened the link in your default browser.</x:String>
    <x:String x:Key="Str.Scan.UrlOpenFailed">Failed to open the link: {0}</x:String>
    <x:String x:Key="Str.Scan.HoverHint"> Hover a box on the preview to see its content.</x:String>
    <x:String x:Key="Str.Scan.NoCode">No code found ({0}, {1} ms). If it stays unreadable, open "Process image manually" above and walk through the levels.</x:String>
    <x:String x:Key="Str.Scan.Preprocess">Process image manually</x:String>
    <x:String x:Key="Str.Scan.PreprocessClose">Collapse</x:String>
    <x:String x:Key="Str.Scan.PreprocessNeedImage">Scan an image first, then you can process it manually.</x:String>
    <x:String x:Key="Str.Scan.PreprocessNoEffect">"{0}" made no difference on this image (no new level is added).</x:String>
    <x:String x:Key="Str.Scan.PreprocessOriginal">Original (no preprocessing)</x:String>
    <x:String x:Key="Str.Scan.PreprocessStep">Level {0}/{1} · {2}</x:String>
    <x:String x:Key="Str.Scan.PreprocessRescan">Scan this level</x:String>
    <x:String x:Key="Str.Scan.PreprocessSave">Save this method</x:String>
    <x:String x:Key="Str.Scan.PreprocessLoad">Load</x:String>
    <x:String x:Key="Str.Scan.PreprocessAdd">Add a step:</x:String>
    <x:String x:Key="Str.Scan.PreprocessRemove">Remove step</x:String>
    <x:String x:Key="Str.Scan.PreprocessUp">Move up</x:String>
    <x:String x:Key="Str.Scan.PreprocessDown">Move down</x:String>
    <x:String x:Key="Str.Scan.PreprocessKeys">J/K or ↑↓ switch level · H/L or ←→ adjust the current step's parameter · PgUp/PgDn jump to first/last</x:String>
    <x:String x:Key="Str.Scan.PreprocessMethods">Saved methods</x:String>
    <x:String x:Key="Str.Scan.MethodDefaultName">Method {0}</x:String>
    <x:String x:Key="Str.Scan.MethodSaved">Method "{0}" saved to {1}</x:String>
    <x:String x:Key="Str.Scan.MethodSaveFailed">Failed to save the method: {0}</x:String>
    <x:String x:Key="Str.Scan.MethodLoaded">Loaded method "{0}"</x:String>
    <x:String x:Key="Str.Scan.PickImagesTitle">Choose images to scan</x:String>

    <!-- Result kinds -->
    <x:String x:Key="Str.Kind.Text">Text</x:String>
    <x:String x:Key="Str.Kind.Url">Link</x:String>
    <x:String x:Key="Str.Kind.Wifi">WiFi</x:String>
    <x:String x:Key="Str.Kind.VCard">Contact</x:String>
    <x:String x:Key="Str.Kind.Email">Email address</x:String>
    <x:String x:Key="Str.Kind.Phone">Phone number</x:String>
    <x:String x:Key="Str.Kind.Sms">SMS</x:String>
    <x:String x:Key="Str.Kind.Geo">Location</x:String>
    <x:String x:Key="Str.Kind.Json">JSON</x:String>
    <x:String x:Key="Str.Kind.Base64">Base64 text</x:String>

    <!-- One-click actions -->
    <x:String x:Key="Str.Action.Open">Open</x:String>
    <x:String x:Key="Str.Action.OpenUrl">Open link</x:String>
    <x:String x:Key="Str.Action.ComposeEmail">Compose email</x:String>
    <x:String x:Key="Str.Action.Call">Call</x:String>
    <x:String x:Key="Str.Action.SendSms">Send SMS</x:String>
    <x:String x:Key="Str.Action.ViewOnMap">View on map</x:String>
    <x:String x:Key="Str.Action.ViewDecoded">View decoded text</x:String>

    <!-- Generate page -->
    <x:String x:Key="Str.Generate.Template">Content template</x:String>
    <x:String x:Key="Str.Generate.Template.Text">Text</x:String>
    <x:String x:Key="Str.Generate.Template.Wifi">WiFi</x:String>
    <x:String x:Key="Str.Generate.Template.Url">URL</x:String>
    <x:String x:Key="Str.Generate.Template.VCard">Contact</x:String>
    <x:String x:Key="Str.Generate.Template.Geo">Location</x:String>
    <x:String x:Key="Str.Generate.TextPlaceholder">Text to encode</x:String>
    <x:String x:Key="Str.Generate.WifiSsid">WiFi name (SSID)</x:String>
    <x:String x:Key="Str.Generate.WifiPassword">Password</x:String>
    <x:String x:Key="Str.Generate.UrlPlaceholder">example.com (https:// is added automatically)</x:String>
    <x:String x:Key="Str.Generate.Name">Name</x:String>
    <x:String x:Key="Str.Generate.Phone">Phone</x:String>
    <x:String x:Key="Str.Generate.Email">Email</x:String>
    <x:String x:Key="Str.Generate.Latitude">Latitude, e.g. 39.9042</x:String>
    <x:String x:Key="Str.Generate.Longitude">Longitude, e.g. 116.4074</x:String>
    <x:String x:Key="Str.Generate.Format">Barcode type</x:String>
    <x:String x:Key="Str.Generate.Size">Size (px)</x:String>
    <x:String x:Key="Str.Generate.Margin">Quiet zone (modules)</x:String>
    <x:String x:Key="Str.Generate.ErrorCorrection">Error correction (QR only)</x:String>
    <x:String x:Key="Str.Generate.Logo">Center logo (PNG only; use ECC level H)</x:String>
    <x:String x:Key="Str.Generate.PickLogo">Choose logo…</x:String>
    <x:String x:Key="Str.Generate.ClearLogo">Clear</x:String>
    <x:String x:Key="Str.Generate.LogoScale">Logo width ratio</x:String>
    <x:String x:Key="Str.Generate.Save">Save…</x:String>
    <x:String x:Key="Str.Generate.CopyImage">Copy image</x:String>
    <x:String x:Key="Str.Generate.PickLogoTitle">Choose a logo image</x:String>
    <x:String x:Key="Str.Generate.Status.Hint">Any change regenerates the preview immediately.</x:String>
    <x:String x:Key="Str.Generate.Status.NeedFields">Fill in the required fields first (WiFi name / contact name).</x:String>
    <x:String x:Key="Str.Generate.Status.Empty">Content is empty.</x:String>
    <x:String x:Key="Str.Generate.Status.NothingToSave">Nothing to save yet.</x:String>
    <x:String x:Key="Str.Generate.Status.SvgIgnoresLogo">(SVG is vector output, the logo was ignored)</x:String>
    <x:String x:Key="Str.Generate.Status.Saved">Saved to {0}</x:String>
    <x:String x:Key="Str.Generate.Status.SaveFailed">Save failed: {0}</x:String>
    <x:String x:Key="Str.Generate.Status.ImageCopied">Barcode image copied to the clipboard.</x:String>
    <x:String x:Key="Str.Generate.Status.CopyFailed">Copy failed: {0}</x:String>
    <x:String x:Key="Str.Generate.Status.NothingToCopy">Nothing to copy yet.</x:String>
    <x:String x:Key="Str.Generate.Status.PayloadCopied">Content copied to the clipboard.</x:String>
    <x:String x:Key="Str.Generate.Status.PayloadCopyFailed">Copy failed (clipboard unavailable).</x:String>
    <x:String x:Key="Str.Generate.Status.LogoFailed">Failed to read the logo: {0}</x:String>
    <x:String x:Key="Str.Generate.Status.SizeInfo">{0} · {1}×{2} px{3}</x:String>
    <x:String x:Key="Str.Generate.Status.LogoApplied"> · logo applied</x:String>

    <!-- Settings page -->
    <x:String x:Key="Str.Settings.Platform">Platform capabilities</x:String>
    <x:String x:Key="Str.Settings.CaptureLabel">Capture:</x:String>
    <x:String x:Key="Str.Settings.NotificationLabel">Notify:</x:String>
    <x:String x:Key="Str.Settings.AutoStartLabel">Auto-start:</x:String>
    <x:String x:Key="Str.Settings.General">General</x:String>
    <x:String x:Key="Str.Settings.AutoStartToggle">Start on login</x:String>
    <x:String x:Key="Str.Settings.Recognition">Scanning</x:String>
    <x:String x:Key="Str.Settings.ShowMainWindowAfterCaptureScan">Show the main window after capture scanning (default Ctrl+F1)</x:String>
    <x:String x:Key="Str.Settings.PinSection">Pinning</x:String>
    <x:String x:Key="Str.Settings.PinSectionNote">Everything from the clipboard to the screen: what gets pinned and how it behaves afterwards.</x:String>
    <x:String x:Key="Str.Settings.PinTopmostByDefault">New pins stay on top</x:String>
    <x:String x:Key="Str.Settings.AnimatedFreezeKey">Animated pin freeze key</x:String>
    <x:String x:Key="Str.Settings.AnimatedFreezeKeyNote">While the cursor is over an animated pin, hold this key to freeze it on the current frame; release to continue from that frame. Pick “Off” to disable.</x:String>
    <x:String x:Key="Str.Settings.AnimatedFreezeShift">Shift</x:String>
    <x:String x:Key="Str.Settings.AnimatedFreezeControl">Ctrl</x:String>
    <x:String x:Key="Str.Settings.AnimatedFreezeAlt">Alt</x:String>
    <x:String x:Key="Str.Settings.AnimatedFreezeOff">Off</x:String>
    <x:String x:Key="Str.Settings.PinTopmostByDefaultNote">When off, new pinned images sit at the normal level and can be covered by other windows; each one can still be toggled from its context menu or the hotkey.</x:String>
    <x:String x:Key="Str.Settings.MultiScreen">Multi-monitor</x:String>
    <x:String x:Key="Str.Settings.AnnotationSection">Annotation</x:String>
    <x:String x:Key="Str.Settings.AnnotationNote">Defaults for the annotation editor (capture &amp; annotate / annotate clipboard / screen annotation).</x:String>
    <x:String x:Key="Str.Settings.AnnotationThickness">Default thickness</x:String>
    <x:String x:Key="Str.Settings.AnnotationColor">Default color</x:String>
    <x:String x:Key="Str.Settings.MultiScreenNote">Cross-screen selection: the mask covers every display, so you can drag from one monitor into another and get a single stitched image.</x:String>
    <x:String x:Key="Str.Settings.CaptureAcrossScreens">Cross-screen selection</x:String>
    <x:String x:Key="Str.Settings.CaptureAcrossScreensNote">Stitched at each display's native pixels (1:1, no resampling); gaps between displays stay transparent; pinning puts it back at the original cross-screen position.</x:String>
    <x:String x:Key="Str.Settings.CaptureAcrossScreensDetectNote">In cross-screen mode, window and element detection only work on the display under the cursor.</x:String>
    <x:String x:Key="Str.Settings.MultiScreenGapFill">Gap fill</x:String>
    <x:String x:Key="Str.Settings.MultiScreenGapTransparent">Transparent</x:String>
    <x:String x:Key="Str.Settings.MultiScreenGapBlack">Black</x:String>
    <x:String x:Key="Str.Settings.MultiScreenGapFillNote">When displays are not flush against each other, the areas no display covers come out black from the system capture. “Transparent” keeps only the real area in the PNG; pick “Black” if a program refuses transparent images.</x:String>
    <x:String x:Key="Str.Settings.MultiScreenWindowDetection">Detect the window under the cursor</x:String>
    <x:String x:Key="Str.Settings.MultiScreenWindowDetectionNote">While capturing across screens, hovering a window frames that window (click to capture it); hovering blank desktop or the taskbar frames the whole virtual desktop. Windows only — no sub-element detection.</x:String>
    <x:String x:Key="Str.Settings.PinHotkeyHint">Pin-related global hotkeys live on the “Global hotkeys” page: pin to screen, toggle on top, close all pins.</x:String>
    <x:String x:Key="Str.Settings.AutoCopyToggle">Copy to the clipboard when exactly one code is found</x:String>
    <x:String x:Key="Str.Settings.Language">Language</x:String>
    <x:String x:Key="Str.Settings.On">On</x:String>
    <x:String x:Key="Str.Settings.Off">Off</x:String>
    <x:String x:Key="Str.Settings.SessionWayland">Wayland session: global hotkeys and always-on-top are limited by the protocol; capture is delegated to an external command (see below).</x:String>
    <x:String x:Key="Str.Settings.SessionX11">X11 session: capture and hotkeys are fully available.</x:String>
    <x:String x:Key="Str.Settings.AutoStartOn">Auto-start enabled.</x:String>
    <x:String x:Key="Str.Settings.AutoStartOff">Auto-start disabled.</x:String>
    <x:String x:Key="Str.Settings.AutoStartFailed">Failed: {0}</x:String>
    <x:String x:Key="Str.Settings.ConfigPath">Settings file: {0}</x:String>
    <x:String x:Key="Str.Settings.ConfigPathError">Settings file: {0} (read/write failed: {1})</x:String>
    <x:String x:Key="Str.Settings.AutoStartNote">Note: on Windows auto-start writes the HKCU Run key (no admin needed); on Linux it writes ~/.config/autostart/kscan.desktop.</x:String>
    <x:String x:Key="Str.Settings.LanguageNote">The language is stored in the settings file and kept across restarts.</x:String>
    <x:String x:Key="Str.Settings.Permissions">Permissions</x:String>
    <x:String x:Key="Str.Settings.Theme">Appearance / Theme</x:String>
    <x:String x:Key="Str.Settings.ThemePreviewTitle">Theme preview</x:String>
    <x:String x:Key="Str.Settings.ThemePreviewBody">This text and the swatches below update as you edit colors.</x:String>
    <x:String x:Key="Str.Settings.ThemeLabel">Theme</x:String>
    <x:String x:Key="Str.Settings.ThemeSystem">Follow system</x:String>
    <x:String x:Key="Str.Settings.ThemeOpenFolder">Open themes folder</x:String>
    <x:String x:Key="Str.Settings.ThemeReload">Reload</x:String>
    <x:String x:Key="Str.Settings.ThemeExport">Export current theme</x:String>
    <x:String x:Key="Str.Settings.ColorPick">Pick from palette</x:String>
    <x:String x:Key="Str.Settings.ColorBackground">Background</x:String>
    <x:String x:Key="Str.Settings.ColorForeground">Foreground</x:String>
    <x:String x:Key="Str.Settings.ColorMuted">Muted text</x:String>
    <x:String x:Key="Str.Settings.ColorAccent">Accent</x:String>
    <x:String x:Key="Str.Settings.ColorPanel">Panel</x:String>
    <x:String x:Key="Str.Settings.ColorBorder">Border</x:String>
    <x:String x:Key="Str.Settings.ColorWarning">Warning</x:String>
    <x:String x:Key="Str.Settings.ColorSuccess">Success</x:String>
    <x:String x:Key="Str.Settings.ColorDanger">Danger</x:String>
    <x:String x:Key="Str.Settings.ColorSelection">Selection</x:String>
    <x:String x:Key="Str.Settings.ColorMask">Capture mask</x:String>
    <x:String x:Key="Str.Settings.ThemeColorsReset">Reset theme</x:String>
    <x:String x:Key="Str.Settings.ThemeSaveCurrent">Save to this theme</x:String>
    <x:String x:Key="Str.Settings.ThemeSaveAs">Save as new theme</x:String>
    <x:String x:Key="Str.Settings.ThemeSavedCurrent">Theme file written: {0}</x:String>
    <x:String x:Key="Str.Settings.ThemeSaveFailed">Could not write the theme: {0}</x:String>
    <x:String x:Key="Str.Settings.ThemeStaged">The edits above are a live preview only: click "Save to this theme" to write the file, or "Reset theme" to drop them.</x:String>
    <x:String x:Key="Str.Settings.ThemeName">Theme name</x:String>
    <x:String x:Key="Str.Settings.ThemeNameHint">Used by "Save as new theme", e.g. My Dark</x:String>
    <x:String x:Key="Str.Settings.ThemeNeedName">Type a name in "Theme name" first, then click "Save as new theme".</x:String>
    <x:String x:Key="Str.Settings.ThemeCustomName">Custom theme</x:String>
    <x:String x:Key="Str.Settings.ThemeEditFile">Edit theme file</x:String>
    <x:String x:Key="Str.Settings.ThemeEditNoFile">This theme has no file (built-in theme / follow system). Use "Save as new theme" first.</x:String>
    <x:String x:Key="Str.Settings.ThemeEditing">Opened in the default editor: {0}</x:String>
    <x:String x:Key="Str.Settings.ThemeCornerRadius">Card corner radius</x:String>
    <x:String x:Key="Str.Settings.ThemePreviewRadius">Preview corner radius</x:String>
    <x:String x:Key="Str.Settings.ThemeFont">Font</x:String>
    <x:String x:Key="Str.Settings.ThemeFontHint">Empty = follow system</x:String>
    <x:String x:Key="Str.Settings.ThemeFontPick">Pick an installed font…</x:String>
    <x:String x:Key="Str.Settings.ThemeFontNote">Type a font name on the left, or pick one of the installed fonts on the right (it fills the field); empty follows the system, an unknown name falls back to the default font.</x:String>
    <x:String x:Key="Str.Settings.ThemeMaskStyle">Capture mask style</x:String>
    <x:String x:Key="Str.Settings.ThemeMaskDim">Dim the screen</x:String>
    <x:String x:Key="Str.Settings.ThemeMaskNone">No mask</x:String>
    <x:String x:Key="Str.Settings.ThemeMaskNote">Layer drawn over the screen while selecting a region: its color is the "Capture mask" row below (A = alpha). "No mask" shows the raw screen with just the selection frame.</x:String>
    <x:String x:Key="Str.Settings.ThemeExportPick">Export theme</x:String>
    <x:String x:Key="Str.Settings.ThemeNote">Themes are JSON files under user/themes: editing a file takes effect automatically, or edit here and save. See README.md in that folder for field docs and how to share.</x:String>
    <x:String x:Key="Str.Settings.ThemeReloaded">Theme list reloaded.</x:String>
    <x:String x:Key="Str.Settings.ThemeOpenFailed">Could not open the themes folder: {0}</x:String>
    <x:String x:Key="Str.Settings.ThemeExported">Theme exported: {0}</x:String>
    <x:String x:Key="Str.Settings.ThemeExportFailed">Could not export the theme: {0}</x:String>
    <x:String x:Key="Str.Settings.Interface">Interface</x:String>
    <x:String x:Key="Str.Settings.ShowPlatformSummary">Show the platform summary at the window bottom</x:String>
    <x:String x:Key="Str.Settings.OpenUrlToggle">Open a single link result immediately</x:String>
    <x:String x:Key="Str.Settings.OpenUrlWarning">⚠ Security note: when enabled, a recognized URL is handed to your default browser automatically. Links can come from untrusted sources (a QR/barcode can be forged), so enable this only if you accept that risk.</x:String>

    <!-- Language options -->
    <x:String x:Key="Str.Lang.System">Follow system</x:String>
    <x:String x:Key="Str.Lang.ZhCn">简体中文</x:String>
    <x:String x:Key="Str.Lang.EnUs">English</x:String>

    <!-- System dialogs -->
    <x:String x:Key="Str.Dialog.PickImage">Choose an image</x:String>
    <x:String x:Key="Str.Dialog.SaveBarcode">Save barcode</x:String>
    <x:String x:Key="Str.Dialog.ImagesType">Images</x:String>
    <x:String x:Key="Str.Dialog.PngType">PNG image</x:String>
    <x:String x:Key="Str.Dialog.SvgType">SVG vector image</x:String>

    <!-- Platform capability text (keys come from Kscan.Platform implementations) -->
    <x:String x:Key="Str.Platform.Summary">{0} / {1} · Capture: {2} · Notify: {3} · Auto-start: {4}</x:String>
    <x:String x:Key="Str.Platform.Capture.WindowsBitBlt">Windows BitBlt (whole virtual desktop)</x:String>
    <x:String x:Key="Str.Platform.Capture.LinuxCommand">External command: {0}</x:String>
    <x:String x:Key="Str.Platform.Capture.Unsupported">Screen capture is not supported on this platform</x:String>
    <x:String x:Key="Str.Platform.Notification.Windows">Not supported (the GUI gives its own feedback on Windows)</x:String>
    <x:String x:Key="Str.Platform.Notification.Linux">D-Bus notification (notify-send)</x:String>
    <x:String x:Key="Str.Platform.Notification.Missing">notify-send (libnotify) is missing</x:String>
    <x:String x:Key="Str.Platform.Notification.Unsupported">System notification is not supported on this platform</x:String>
    <x:String x:Key="Str.Platform.AutoStart.Windows">HKCU\Software\Microsoft\Windows\CurrentVersion\Run (no admin needed)</x:String>
    <x:String x:Key="Str.Platform.AutoStart.Linux">~/.config/autostart/kscan.desktop</x:String>
    <x:String x:Key="Str.Platform.AutoStart.Unsupported">Auto-start is not supported on this platform</x:String>
    <x:String x:Key="Str.Platform.Clipboard.Windows">Windows clipboard sequence-number polling (about once per 0.7 s)</x:String>
    <x:String x:Key="Str.Platform.Clipboard.Linux">Wayland/X11 do not notify applications about clipboard changes — trigger the CLI from a compositor key binding instead</x:String>
    <x:String x:Key="Str.Platform.Clipboard.Unsupported">Clipboard watching is not supported on this platform</x:String>
    <x:String x:Key="Str.Settings.ClipboardLabel">Clipboard:</x:String>
    <x:String x:Key="Str.Settings.WatchClipboardToggle">Recognize a new image from the clipboard automatically</x:String>
    <x:String x:Key="Str.Settings.QuickCodeFormat">Code type for quick conversion</x:String>
    <x:String x:Key="Str.Settings.QuickCodeFormatNote">Used when turning clipboard text into a code in one keypress (QR by default).</x:String>
    <x:String x:Key="Str.Settings.WatchClipboardNote">When enabled, images in the clipboard are read and scanned immediately. Clipboard contents can be sensitive — enable this only if you accept that.</x:String>
    <x:String x:Key="Str.Settings.PinRemoteImages">Resolve image URLs when pinning</x:String>
    <x:String x:Key="Str.Settings.PinRemoteImagesNote">When the clipboard holds just an image URL (e.g. https://…/a.png), download it and pin the image; on failure the text is pinned as before. The URL is fetched over the network; private and loopback addresses are always refused.</x:String>

    <!-- Highlight boxes on the preview -->
    <x:String x:Key="Str.Preview.ClickToCopy">Click the box to copy</x:String>
    <x:String x:Key="Str.Scan.CopiedFromBox">Copied that code to the clipboard.</x:String>
    <x:String x:Key="Str.Scan.CopyFailed">Copy failed (clipboard unavailable).</x:String>

    <!-- Pinned images (M3) -->
    <x:String x:Key="Str.Pin.Copy">Copy image</x:String>
    <x:String x:Key="Str.Pin.CopyFrame">Copy current frame</x:String>
    <x:String x:Key="Str.Pin.SaveAs">Save as…</x:String>
    <x:String x:Key="Str.Pin.OriginalSize">Actual size</x:String>
    <x:String x:Key="Str.Pin.Scan">Scan for codes</x:String>
    <x:String x:Key="Str.Pin.RotateLeft">Rotate 90° left</x:String>
    <x:String x:Key="Str.Pin.RotateRight">Rotate 90° right</x:String>
    <x:String x:Key="Str.Pin.MirrorHorizontal">Mirror horizontally</x:String>
    <x:String x:Key="Str.Pin.MirrorVertical">Mirror vertically</x:String>
