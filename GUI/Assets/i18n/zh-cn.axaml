<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 应用 / 页签 -->
    <x:String x:Key="Str.Settings.Recording">录制</x:String>
    <x:String x:Key="Str.Hotkey.Action.RecordVideo">框选录视频 / 停止最近视频</x:String>
    <x:String x:Key="Str.Hotkey.Action.RecordGif">框选录 GIF / 停止最近 GIF</x:String>
    <x:String x:Key="Str.Hotkey.Action.RecordAudio">录音 / 停止最近录音</x:String>
    <x:String x:Key="Str.Hotkey.Action.RecordingPanel">录制与录制设置</x:String>
    <x:String x:Key="Str.Hotkey.Action.StopRecordings">停止全部录制</x:String>
    <x:String x:Key="Str.App.Title">Kscan — 扫码 / 生成</x:String>
    <x:String x:Key="Str.Tab.Scan">识别</x:String>
    <x:String x:Key="Str.Tab.Generate">生成</x:String>
    <x:String x:Key="Str.Tab.Settings">设置</x:String>

    <!-- 识别页 -->
    <x:String x:Key="Str.Scan.OpenFile">从文件…</x:String>
    <x:String x:Key="Str.Scan.FromClipboard">从剪贴板</x:String>
    <x:String x:Key="Str.Scan.CaptureRegion">框选截图</x:String>
    <x:String x:Key="Str.Scan.NoSource">尚未载入图片</x:String>
    <x:String x:Key="Str.Scan.Hint">支持拖放图片、从文件、从剪贴板，或直接框选屏幕区域。</x:String>
    <x:String x:Key="Str.Scan.Copy">复制</x:String>
    <x:String x:Key="Str.Scan.FormatLabel">格式：{0}</x:String>
    <x:String x:Key="Str.Scan.ClipboardEmpty">剪贴板里没有图片。</x:String>
    <x:String x:Key="Str.Scan.ClipboardNoText">剪贴板里没有文本 —— 先复制一段文字再转码。</x:String>
    <x:String x:Key="Str.Scan.CodedToClipboard">已把剪贴板文本转成 {0} 并放进剪贴板。</x:String>
    <x:String x:Key="Str.Scan.CopiedImageToClipboard">截图已复制到剪贴板。</x:String>
    <x:String x:Key="Str.Scan.Capturing">正在截图…</x:String>
    <x:String x:Key="Str.Scan.CaptureUnsupported">当前平台不支持截图：{0}</x:String>
    <x:String x:Key="Str.Scan.CaptureCancelled">截图已取消或失败。</x:String>
    <x:String x:Key="Str.Scan.CaptureFailed">截屏失败。</x:String>
    <x:String x:Key="Str.Scan.RegionCancelled">已取消框选。</x:String>
    <x:String x:Key="Str.Scan.CaptureError">截图出错：{0}</x:String>
    <x:String x:Key="Str.Scan.SourceRegion">框选截图</x:String>
    <x:String x:Key="Str.Scan.SourceAnnotation">截图标注</x:String>
    <x:String x:Key="Str.Scan.SourceClipboard">剪贴板图片</x:String>
    <x:String x:Key="Str.Scan.ReadFailed">读取图片失败：{0}</x:String>
    <x:String x:Key="Str.Scan.ClipboardReadFailed">读取剪贴板图片失败：{0}</x:String>
    <x:String x:Key="Str.Scan.ScanFailed">识别失败：{0}</x:String>
    <x:String x:Key="Str.Scan.FoundWithHint">识别到 {0} 个码，用时 {1} ms。{2}</x:String>
    <x:String x:Key="Str.Scan.AutoCopied"> 已复制到剪贴板。</x:String>
    <x:String x:Key="Str.Scan.AutoCopyDisabled"> 可在设置页开启「自动复制」或「自动打开链接」。</x:String>
    <x:String x:Key="Str.Scan.UrlOpened"> 已用默认浏览器打开链接。</x:String>
    <x:String x:Key="Str.Scan.UrlOpenFailed">打开链接失败：{0}</x:String>
    <x:String x:Key="Str.Scan.HoverHint"> 悬停预览图上的框可查看内容。</x:String>
    <x:String x:Key="Str.Scan.NoCode">没有识别到码（{0}，用时 {1} ms）。没读出来的话，点上面的「手动处理图像」逐层看看。</x:String>
    <x:String x:Key="Str.Scan.Preprocess">手动处理图像</x:String>
    <x:String x:Key="Str.Scan.PreprocessClose">收起</x:String>
    <x:String x:Key="Str.Scan.PreprocessNeedImage">先识别一张图，再手动处理。</x:String>
    <x:String x:Key="Str.Scan.PreprocessNoEffect">「{0}」对这张图没有产生变化（层列表里不会多出一层）。</x:String>
    <x:String x:Key="Str.Scan.PreprocessOriginal">原图（没有预处理）</x:String>
    <x:String x:Key="Str.Scan.PreprocessStep">第 {0}/{1} 层 · {2}</x:String>
    <x:String x:Key="Str.Scan.PreprocessRescan">用这一层重新识别</x:String>
    <x:String x:Key="Str.Scan.PreprocessSave">保存这个方法</x:String>
    <x:String x:Key="Str.Scan.PreprocessLoad">载入</x:String>
    <x:String x:Key="Str.Scan.PreprocessAdd">加一步：</x:String>
    <x:String x:Key="Str.Scan.PreprocessRemove">删这一步</x:String>
    <x:String x:Key="Str.Scan.PreprocessUp">上移</x:String>
    <x:String x:Key="Str.Scan.PreprocessDown">下移</x:String>
    <x:String x:Key="Str.Scan.PreprocessKeys">J/K 或 ↑↓ 切层 · H/L 或 ←→ 调当前步骤的参数 · PgUp/PgDn 跳首尾</x:String>
    <x:String x:Key="Str.Scan.PreprocessMethods">已保存的方法</x:String>
    <x:String x:Key="Str.Scan.MethodDefaultName">方法 {0}</x:String>
    <x:String x:Key="Str.Scan.MethodSaved">方法「{0}」已保存到 {1}</x:String>
    <x:String x:Key="Str.Scan.MethodSaveFailed">保存方法失败：{0}</x:String>
    <x:String x:Key="Str.Scan.MethodLoaded">已载入方法「{0}」</x:String>
    <x:String x:Key="Str.Scan.PickImagesTitle">选择要识别的图片</x:String>

    <!-- 结果分类 -->
    <x:String x:Key="Str.Kind.Text">文本</x:String>
    <x:String x:Key="Str.Kind.Url">链接</x:String>
    <x:String x:Key="Str.Kind.Wifi">WiFi 配置</x:String>
    <x:String x:Key="Str.Kind.VCard">联系人</x:String>
    <x:String x:Key="Str.Kind.Email">邮件地址</x:String>
    <x:String x:Key="Str.Kind.Phone">电话号码</x:String>
    <x:String x:Key="Str.Kind.Sms">短信</x:String>
    <x:String x:Key="Str.Kind.Geo">位置坐标</x:String>
    <x:String x:Key="Str.Kind.Json">JSON</x:String>
    <x:String x:Key="Str.Kind.Base64">Base64 文本</x:String>

    <!-- 一键动作 -->
    <x:String x:Key="Str.Action.Open">打开</x:String>
    <x:String x:Key="Str.Action.OpenUrl">打开链接</x:String>
    <x:String x:Key="Str.Action.ComposeEmail">写邮件</x:String>
    <x:String x:Key="Str.Action.Call">拨打</x:String>
    <x:String x:Key="Str.Action.SendSms">发短信</x:String>
    <x:String x:Key="Str.Action.ViewOnMap">在地图中查看</x:String>
    <x:String x:Key="Str.Action.ViewDecoded">查看解码结果</x:String>

    <!-- 生成页 -->
    <x:String x:Key="Str.Generate.Template">内容模板</x:String>
    <x:String x:Key="Str.Generate.Template.Text">文本</x:String>
    <x:String x:Key="Str.Generate.Template.Wifi">WiFi</x:String>
    <x:String x:Key="Str.Generate.Template.Url">网址</x:String>
    <x:String x:Key="Str.Generate.Template.VCard">联系人</x:String>
    <x:String x:Key="Str.Generate.Template.Geo">位置</x:String>
    <x:String x:Key="Str.Generate.TextPlaceholder">要编码的文本</x:String>
    <x:String x:Key="Str.Generate.WifiSsid">WiFi 名称（SSID）</x:String>
    <x:String x:Key="Str.Generate.WifiPassword">密码</x:String>
    <x:String x:Key="Str.Generate.UrlPlaceholder">example.com（会自动补 https://）</x:String>
    <x:String x:Key="Str.Generate.Name">姓名</x:String>
    <x:String x:Key="Str.Generate.Phone">电话</x:String>
    <x:String x:Key="Str.Generate.Email">邮箱</x:String>
    <x:String x:Key="Str.Generate.Latitude">纬度，例如 39.9042</x:String>
    <x:String x:Key="Str.Generate.Longitude">经度，例如 116.4074</x:String>
    <x:String x:Key="Str.Generate.Format">码制</x:String>
    <x:String x:Key="Str.Generate.Size">尺寸（像素）</x:String>
    <x:String x:Key="Str.Generate.Margin">静区（模块数）</x:String>
    <x:String x:Key="Str.Generate.ErrorCorrection">纠错级别（仅二维码）</x:String>
    <x:String x:Key="Str.Generate.Logo">中心 Logo（仅 PNG；建议纠错级别 H）</x:String>
    <x:String x:Key="Str.Generate.PickLogo">选择 Logo…</x:String>
    <x:String x:Key="Str.Generate.ClearLogo">清除</x:String>
    <x:String x:Key="Str.Generate.LogoScale">Logo 宽度占比</x:String>
    <x:String x:Key="Str.Generate.Save">保存…</x:String>
    <x:String x:Key="Str.Generate.CopyImage">复制图片</x:String>
    <x:String x:Key="Str.Generate.PickLogoTitle">选择 Logo 图片</x:String>
    <x:String x:Key="Str.Generate.Status.Hint">改任意一项都会即时重新生成。</x:String>
    <x:String x:Key="Str.Generate.Status.NeedFields">请先填写必填字段（WiFi 名称 / 联系人姓名）。</x:String>
    <x:String x:Key="Str.Generate.Status.Empty">内容为空。</x:String>
    <x:String x:Key="Str.Generate.Status.NothingToSave">还没有可保存的内容。</x:String>
    <x:String x:Key="Str.Generate.Status.SvgIgnoresLogo">（SVG 为矢量输出，已忽略 Logo）</x:String>
    <x:String x:Key="Str.Generate.Status.Saved">已保存到 {0}</x:String>
    <x:String x:Key="Str.Generate.Status.SaveFailed">保存失败：{0}</x:String>
    <x:String x:Key="Str.Generate.Status.ImageCopied">条码图片已复制到剪贴板。</x:String>
    <x:String x:Key="Str.Generate.Status.CopyFailed">复制失败：{0}</x:String>
    <x:String x:Key="Str.Generate.Status.NothingToCopy">还没有可复制的内容。</x:String>
    <x:String x:Key="Str.Generate.Status.PayloadCopied">内容已复制到剪贴板。</x:String>
    <x:String x:Key="Str.Generate.Status.PayloadCopyFailed">复制失败（剪贴板不可用）。</x:String>
    <x:String x:Key="Str.Generate.Status.LogoFailed">Logo 读取失败：{0}</x:String>
    <x:String x:Key="Str.Generate.Status.SizeInfo">{0} · {1}×{2} 像素{3}</x:String>
    <x:String x:Key="Str.Generate.Status.LogoApplied"> · 已叠加 Logo</x:String>

    <!-- 设置页 -->
    <x:String x:Key="Str.Settings.Platform">平台能力</x:String>
    <x:String x:Key="Str.Settings.CaptureLabel">截图：</x:String>
    <x:String x:Key="Str.Settings.NotificationLabel">通知：</x:String>
    <x:String x:Key="Str.Settings.AutoStartLabel">自启：</x:String>
    <x:String x:Key="Str.Settings.General">通用</x:String>
    <x:String x:Key="Str.Settings.AutoStartToggle">开机自动启动</x:String>
    <x:String x:Key="Str.Settings.Recognition">识别</x:String>
    <x:String x:Key="Str.Settings.ShowMainWindowAfterCaptureScan">截图扫码后自动打开主页面（默认 Ctrl+F1）</x:String>
    <x:String x:Key="Str.Settings.PinSection">贴图</x:String>
    <x:String x:Key="Str.Settings.PinSectionNote">从剪贴板到屏幕这一段：贴什么、贴上去之后怎么显示。</x:String>
    <x:String x:Key="Str.Settings.PinTopmostByDefault">新贴图默认置顶</x:String>
    <x:String x:Key="Str.Settings.AnimatedFreezeKey">动图定格键</x:String>
    <x:String x:Key="Str.Settings.AnimatedFreezeKeyNote">光标停在动图上时，按住这个键让动画停在当前帧，松开从这一帧继续。选「关闭」则不启用。</x:String>
    <x:String x:Key="Str.Settings.AnimatedFreezeShift">Shift</x:String>
    <x:String x:Key="Str.Settings.AnimatedFreezeControl">Ctrl</x:String>
    <x:String x:Key="Str.Settings.AnimatedFreezeAlt">Alt</x:String>
    <x:String x:Key="Str.Settings.AnimatedFreezeOff">关闭</x:String>
    <x:String x:Key="Str.Settings.MultiScreen">多屏</x:String>
    <x:String x:Key="Str.Settings.AnnotationSection">标注</x:String>
    <x:String x:Key="Str.Settings.AnnotationNote">标注编辑器（截图并标注 / 标注剪贴板 / 屏幕批注层）的默认外观。</x:String>
    <x:String x:Key="Str.Settings.AnnotationThickness">默认线宽</x:String>
    <x:String x:Key="Str.Settings.AnnotationColor">默认颜色</x:String>
    <x:String x:Key="Str.Settings.MultiScreenNote">跨屏框选：遮罩覆盖所有显示器，可以从一块屏拖到另一块，截出来的是一张拼好的图。</x:String>
    <x:String x:Key="Str.Settings.CaptureAcrossScreens">跨屏框选</x:String>
    <x:String x:Key="Str.Settings.CaptureAcrossScreensNote">按各显示器的物理像素 1:1 拼接（不重采样）；显示器之间有空档时留透明；贴回屏幕时按原来的跨屏位置显示。</x:String>
    <x:String x:Key="Str.Settings.CaptureAcrossScreensDetectNote">跨屏模式下，窗口识别与子元素识别只在光标所在的显示器上生效。</x:String>
    <x:String x:Key="Str.Settings.MultiScreenGapFill">空档填充</x:String>
    <x:String x:Key="Str.Settings.MultiScreenGapTransparent">透明</x:String>
    <x:String x:Key="Str.Settings.MultiScreenGapBlack">黑色</x:String>
    <x:String x:Key="Str.Settings.MultiScreenGapFillNote">显示器不是整齐相邻时（上下错开、围出空档），这些空档在系统截图里本来是黑色。选「透明」拼出来的 PNG 只含真实存在的区域；某些程序不接受透明图片时选「黑色」。</x:String>
    <x:String x:Key="Str.Settings.MultiScreenWindowDetection">识别光标下的窗口</x:String>
    <x:String x:Key="Str.Settings.MultiScreenWindowDetectionNote">跨屏框选时光标停在窗口上会框出那个窗口（单击直接截它）；停在空白桌面/任务栏上时框的是整个虚拟桌面。只识别窗口，不识别窗口里的子元素。</x:String>
    <x:String x:Key="Str.Settings.PinTopmostByDefaultNote">关掉后新贴出来的图会落在普通层级，被其它窗口盖住；单张仍可用右键菜单或热键随时切换。</x:String>
    <x:String x:Key="Str.Settings.PinHotkeyHint">贴图的全局热键在「全局热键」页：贴到屏幕、置顶开关、关闭全部贴图。</x:String>
    <x:String x:Key="Str.Settings.AutoCopyToggle">只识别到一个码时自动复制到剪贴板</x:String>
    <x:String x:Key="Str.Settings.Language">语言</x:String>
    <x:String x:Key="Str.Settings.On">开</x:String>
    <x:String x:Key="Str.Settings.Off">关</x:String>
    <x:String x:Key="Str.Settings.SessionWayland">Wayland 会话：全局热键与窗口置顶受协议限制，截图走外部命令（见下方）。</x:String>
    <x:String x:Key="Str.Settings.SessionX11">X11 会话：截图/热键可完整使用。</x:String>
    <x:String x:Key="Str.Settings.AutoStartOn">已加入开机自启。</x:String>
    <x:String x:Key="Str.Settings.AutoStartOff">已取消开机自启。</x:String>
    <x:String x:Key="Str.Settings.AutoStartFailed">设置失败：{0}</x:String>
    <x:String x:Key="Str.Settings.ConfigPath">配置文件：{0}</x:String>
    <x:String x:Key="Str.Settings.ConfigPathError">配置文件：{0}（读写失败：{1}）</x:String>
    <x:String x:Key="Str.Settings.AutoStartNote">说明：Windows 下自启写 HKCU 的 Run 键（不需要管理员）；Linux 下写 ~/.config/autostart/kscan.desktop。</x:String>
    <x:String x:Key="Str.Settings.LanguageNote">语言会写入配置文件，重启后保持。</x:String>
    <x:String x:Key="Str.Settings.Permissions">权限</x:String>
    <x:String x:Key="Str.Settings.Theme">外观 / 主题</x:String>
    <x:String x:Key="Str.Settings.ThemePreviewTitle">主题预览</x:String>
    <x:String x:Key="Str.Settings.ThemePreviewBody">这段文字与下面的色块会随颜色即时变化。</x:String>
    <x:String x:Key="Str.Settings.ThemeLabel">主题</x:String>
    <x:String x:Key="Str.Settings.ThemeSystem">跟随系统</x:String>
    <x:String x:Key="Str.Settings.ThemeOpenFolder">打开主题文件夹</x:String>
    <x:String x:Key="Str.Settings.ThemeReload">重新加载</x:String>
    <x:String x:Key="Str.Settings.ThemeExport">导出当前主题</x:String>
    <x:String x:Key="Str.Settings.ColorPick">从色板选色</x:String>
    <x:String x:Key="Str.Settings.ColorBackground">背景</x:String>
    <x:String x:Key="Str.Settings.ColorForeground">前景</x:String>
    <x:String x:Key="Str.Settings.ColorMuted">次要文字</x:String>
    <x:String x:Key="Str.Settings.ColorAccent">强调</x:String>
    <x:String x:Key="Str.Settings.ColorPanel">面板</x:String>
    <x:String x:Key="Str.Settings.ColorBorder">边框</x:String>
    <x:String x:Key="Str.Settings.ColorWarning">警告</x:String>
    <x:String x:Key="Str.Settings.ColorSuccess">成功</x:String>
    <x:String x:Key="Str.Settings.ColorDanger">危险</x:String>
    <x:String x:Key="Str.Settings.ColorSelection">选中</x:String>
    <x:String x:Key="Str.Settings.ColorMask">截图遮罩</x:String>
    <x:String x:Key="Str.Settings.ThemeColorsReset">恢复主题</x:String>
    <x:String x:Key="Str.Settings.ThemeSaveCurrent">保存到当前主题</x:String>
    <x:String x:Key="Str.Settings.ThemeSaveAs">另存为新主题</x:String>
    <x:String x:Key="Str.Settings.ThemeSavedCurrent">已写入主题文件：{0}</x:String>
    <x:String x:Key="Str.Settings.ThemeSaveFailed">写入主题失败：{0}</x:String>
    <x:String x:Key="Str.Settings.ThemeStaged">上面的改动现在只是内存里的预览：点「保存到当前主题」才会写文件；不想要就点「恢复主题」。</x:String>
    <x:String x:Key="Str.Settings.ThemeName">主题名</x:String>
    <x:String x:Key="Str.Settings.ThemeNameHint">另存为新主题时用，例如「我的深色」</x:String>
    <x:String x:Key="Str.Settings.ThemeNeedName">先在「主题名」里填一个名字，再点「另存为新主题」。</x:String>
    <x:String x:Key="Str.Settings.ThemeCustomName">自定义主题</x:String>
    <x:String x:Key="Str.Settings.ThemeEditFile">编辑主题文件</x:String>
    <x:String x:Key="Str.Settings.ThemeEditNoFile">当前主题没有对应文件（内置主题 / 跟随系统），先「另存为新主题」。</x:String>
    <x:String x:Key="Str.Settings.ThemeEditing">已用默认编辑器打开：{0}</x:String>
    <x:String x:Key="Str.Settings.ThemeCornerRadius">卡片圆角</x:String>
    <x:String x:Key="Str.Settings.ThemePreviewRadius">预览框圆角</x:String>
    <x:String x:Key="Str.Settings.ThemeFont">字体</x:String>
    <x:String x:Key="Str.Settings.ThemeFontHint">留空 = 跟随系统</x:String>
    <x:String x:Key="Str.Settings.ThemeFontPick">从系统字体里挑…</x:String>
    <x:String x:Key="Str.Settings.ThemeFontNote">左边可以直接手填字体名，右边列出系统里已装的字体（选中即填入左边）；留空 = 跟随系统，写错的字体名会退回系统默认字体。</x:String>
    <x:String x:Key="Str.Settings.ThemeMaskStyle">截图遮罩样式</x:String>
    <x:String x:Key="Str.Settings.ThemeMaskDim">整屏变暗</x:String>
    <x:String x:Key="Str.Settings.ThemeMaskNone">不遮罩</x:String>
    <x:String x:Key="Str.Settings.ThemeMaskNote">框选截图时盖在屏幕上的那层：颜色由下面颜色表里的「截图遮罩」决定（A = 透明度）。选「不遮罩」就只看原图 + 选框。</x:String>
    <x:String x:Key="Str.Settings.ThemeExportPick">导出主题</x:String>
    <x:String x:Key="Str.Settings.ThemeNote">主题是 user/themes 下的 JSON 文件：直接在编辑器里改会自动生效，也可以在这里改完点保存。文件夹里的 README.md 有字段说明与分享方式。</x:String>
    <x:String x:Key="Str.Settings.ThemeReloaded">已重新加载主题列表。</x:String>
    <x:String x:Key="Str.Settings.ThemeOpenFailed">打开主题文件夹失败：{0}</x:String>
    <x:String x:Key="Str.Settings.ThemeExported">已导出主题：{0}</x:String>
    <x:String x:Key="Str.Settings.ThemeExportFailed">导出主题失败：{0}</x:String>
    <x:String x:Key="Str.Settings.Interface">界面</x:String>
