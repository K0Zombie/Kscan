<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <ProjectReference Include="../../GUI/Kscan.App.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Kscan.Core.Tests/ScrollStitcherTests.cs" Link="ScrollStitcherTests.cs" />
    <Compile Include="../Kscan.Core.Tests/SkiaImageCodecTests.cs" Link="SkiaImageCodecTests.cs" />
    <!-- 动图测试素材（Pillow 生成：GIF / 动画 WebP / APNG），跟着输出目录走 -->
    <None Update="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
